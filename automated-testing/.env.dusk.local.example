# Salin berkas ini menjadi  ecochallenge/.env.dusk.local  lalu sesuaikan.
# Berkas itu TIDAK ikut di-commit (sudah di .gitignore) dan dipakai Dusk menggantikan .env
# selama tes berjalan, jadi data asli/demo kamu tidak tersentuh.
#
# Cara cepat: salin isi ecochallenge/.env kamu, lalu ubah/tambahkan baris di bawah ini.

APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Basis data TERPISAH untuk tes (Dusk mengosongkan dan membuatnya ulang tiap tes).
# Ganti path di bawah dengan path mutlak di komputermu, lalu buat berkas kosongnya
# (ecochallenge/database/dusk.sqlite).
DB_CONNECTION=sqlite
DB_DATABASE=E:\EcoChallenge-PPL\KELOMPOK-BC\ecochallenge\database\dusk.sqlite

SESSION_DRIVER=file
CACHE_STORE=file

# true = jendela browser tampil sehingga klik dan ketik otomatis bisa ditonton
DUSK_HEADLESS_DISABLED=true
DUSK_START_MAXIMIZED=true

# Jeda antarlangkah dalam milidetik (makin besar makin pelan)
DUSK_JEDA=700

# Opsional: pakai browser Chromium lain (mis. Brave) alih-alih Chrome.
# Versi utama chromedriver harus sama dengan versi Chromium browser itu.
# DUSK_CHROME_BINARY=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
